# Prisma Database URL
# Para SQLite (default local):
DATABASE_URL="file:./dev.db"
# Para SQLite en Fly.io (producción):
# DATABASE_URL="file:/app/data/prod.db"
# Para PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/naturedb"

# Admin Access Code - Código secreto para acceso temporal como administrador
ADMIN_ACCESS_CODE="cambiar_por_codigo_secreto"
