generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
  nombre   String
  role     String   @default("USER")
  puntos   Int      @default(0)
  createdAt DateTime @default(now())
  
  favoritos  Favorito[]
  comentarios Comentario[]
  actividades Actividad[]
}

model Animal {
  id          Int      @id @default(autoincrement())
  nombre      String
  especie     String?
  habitat     String
  riesgo      String
  descripcion String?
  imagenUrl   String?
  createdAt   DateTime @default(now())
  
  favoritos Favorito[]
  comentarios Comentario[]
  imagenes Imagen[]
}

model Planta {
  id          Int      @id @default(autoincrement())
  nombre      String
  especie     String?
  habitat     String
  riesgo      String
  descripcion String?
  imagenUrl   String?
  createdAt   DateTime @default(now())
  
  favoritos Favorito[]
  comentarios Comentario[]
  imagenes Imagen[]
}

model Favorito {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  animalId  Int?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  plantaId  Int?
  planta    Planta?  @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  
  @@unique([usuarioId, animalId])
  @@unique([usuarioId, plantaId])
}

model Comentario {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  animalId  Int?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  plantaId  Int?
  planta    Planta?  @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  contenido String
  createdAt DateTime @default(now())
}

model NewsletterSuscriptor {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Imagen {
  id        Int      @id @default(autoincrement())
  animalId  Int?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  plantaId  Int?
  planta    Planta?  @relation(fields: [plantaId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model Actividad {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      String   // "favorito", "comentario", "registro"
  puntos    Int
  createdAt DateTime @default(now())
}