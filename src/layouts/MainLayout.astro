---
interface Props {
    title: string;
}

const { title } = Astro.props;

// GESTIÓN DE SESIÓN
const userName = Astro.cookies.get("user_name")?.value;
const userId = Astro.cookies.get("user_id")?.value;
const userRole = Astro.cookies.get("user_role")?.value;
const isAdmin = userRole === "ADMIN";

// Obtener puntos del usuario
let userPuntos = 0;
let userFavoritos = 0;
if (userId || userName) {
  try {
    const { prisma } = await import('../lib/db');
        const user = userId
            ? await prisma.user.findUnique({
                    where: { id: parseInt(userId) },
                    select: { id: true, puntos: true }
                })
            : await prisma.user.findFirst({
                    where: { nombre: userName },
                    select: { id: true, puntos: true }
                });
    if (user) {
      userPuntos = user.puntos;
            userFavoritos = await prisma.favorito.count({ where: { usuarioId: user.id } });
    }
  } catch (e) {
    console.error("Error al obtener puntos:", e);
  }
}
---

<html lang="es">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <title>{title} | NatureApp</title>
        <style is:global>
            :root {
                --primary: #2d5a27;
                --secondary: #f4f1ea;
                --accent: #8b4513;
                --text: #333;
                --danger: #e63946;
            }
            body {
                font-family: system-ui, sans-serif;
                background: linear-gradient(135deg, #e8f5e9 0%, #f4f1ea 50%, #e0f2f1 100%);
                background-attachment: fixed;
                color: var(--text);
                margin: 0;
            }
            body::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: 
                    radial-gradient(circle at 20% 50%, rgba(45, 90, 39, 0.03) 0%, transparent 50%),
                    radial-gradient(circle at 80% 80%, rgba(139, 69, 19, 0.03) 0%, transparent 50%);
                pointer-events: none;
                z-index: -1;
            }
            nav {
                background: var(--primary);
                color: white;
                padding: 1rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
                gap: 2rem;
            }
            nav a {
                color: white;
                text-decoration: none;
                font-size: 0.95rem;
            }
            .nav-brand {
                font-size: 1.3rem !important;
                font-weight: bold;
                margin: 0 !important;
            }
            .nav-links {
                display: flex;
                gap: 1.5rem;
                flex: 1;
            }
            .nav-links a {
                transition: opacity 0.2s;
            }
            .nav-links a:hover {
                opacity: 0.7;
            }
            .user-info {
                display: flex;
                align-items: center;
                gap: 15px;
            }

            .points-badge {
                background: rgba(255, 255, 255, 0.2);
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: bold;
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .favorites-badge {
                background: rgba(255, 255, 255, 0.2);
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: bold;
                display: flex;
                align-items: center;
                gap: 5px;
            }

            .btn-add {
                background: white;
                color: var(--primary) !important;
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-weight: bold;
            }
            .logout-btn {
                background: rgba(255, 255, 255, 0.15);
                padding: 0.4rem 0.8rem;
                border-radius: 6px;
                font-size: 0.85rem;
            }
            .logout-btn:hover {
                background: var(--danger);
            }

            .admin-badge {
                font-size: 0.7rem;
                background: #ffd700;
                color: black;
                padding: 2px 6px;
                border-radius: 4px;
                font-weight: 800;
            }

            main {
                padding: 2rem;
                max-width: 1100px;
                margin: auto;
                min-height: 80vh;
            }
            footer {
                text-align: center;
                padding: 3rem 1rem;
                color: #666;
                border-top: 1px solid #ddd;
                margin-top: 3rem;
            }
        </style>
    </head>
    <body>
        <nav>
    <a href="/" class="nav-brand">🌿 NatureApp</a>
    <div class="nav-links">
        <a href="/">Inicio</a>
        <a href="/animales">Animales</a>
        <a href="/plantas">Plantas</a>
    </div>
    <div class="user-info">
        {
            userName ? (
                <>
                    <span>
                        Hola, <a href="/perfil" style="color: white; text-decoration: none; font-weight: bold; cursor: pointer;">{userName}</a>
                    </span>
                    
                    {/* Mostrar puntos */}
                    <span class="points-badge">
                        🏆 {userPuntos} puntos
                    </span>

                    <span class="favorites-badge">
                        ❤️ <span id="nav-favorites-count">{userFavoritos}</span>
                    </span>
                    
                    {/* SOLO EL ADMIN LLEVA LA PLACA */}
                    {isAdmin && <span class="admin-badge">ADMIN</span>}
                    
                    <a href="/api/logout" class="logout-btn">
                        Salir
                    </a>
                </>
            ) : (
                /* SI NO HAY SESIÓN: Botón de acceso general */
                <a
                    href="/login"
                    style="background: white; color: var(--primary); padding: 0.5rem 1rem; border-radius: 8px; font-weight: bold; display: flex; align-items: center; gap: 5px;"
                >
                    <span>🔑</span> Acceder
                </a>
            )
        }
    </div>
</nav>

        <main>
            <slot />
        </main>

        <footer>
            <p><strong>Proyecto Fauna - 2026</strong> | Astro + Prisma</p>
        </footer>

        <script is:inline>
            window.addEventListener('favorites:delta', (event) => {
                const customEvent = event;
                const delta = Number(customEvent.detail?.delta || 0);
                const counter = document.getElementById('nav-favorites-count');
                if (!counter || !delta) return;

                const current = Number(counter.textContent || '0');
                const next = Math.max(0, current + delta);
                counter.textContent = String(next);
            });
        </script>
    </body>
</html>
