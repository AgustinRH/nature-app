---
import MainLayout from '../../layouts/MainLayout.astro';
import { prisma } from '../../lib/db';

// 1. Obtenemos el ID de la URL
const { id } = Astro.params;

// 2. Consultamos la base de datos (con manejo de errores)
let animal;
let comentarios;
let imagenes;
try {
  animal = await prisma.animal.findUnique({
    where: { id: Number(id) },
    include: {
      comentarios: {
        include: {
          usuario: {
            select: { nombre: true, id: true }
          }
        },
        orderBy: { createdAt: 'desc' }
      },
      imagenes: {
        orderBy: { createdAt: 'desc' }
      }
    }
  });
  
  if (animal) {
    comentarios = animal.comentarios || [];
    imagenes = animal.imagenes || [];
  }
} catch (e) {
  console.error("Error al consultar animal:", e);
}

// 3. Si no existe, redirigimos a 404
if (!animal) {
  return Astro.redirect('/404');
}

// 4. Obtener datos de sesión
const userName = Astro.cookies.get('user_name')?.value;
let userId = parseInt(Astro.cookies.get('user_id')?.value || '0');

if (!userId && userName) {
  const userByName = await prisma.user.findFirst({ where: { nombre: userName }, select: { id: true } });
  if (userByName) {
    userId = userByName.id;
  }
}

let isFavorito = false;
if (userId) {
  const favorito = await prisma.favorito.findUnique({
    where: {
      usuarioId_animalId: {
        usuarioId: userId,
        animalId: animal.id
      }
    }
  });
  isFavorito = Boolean(favorito);
}

// 5. Formateo de fecha para que quede elegante
const fechaRegistro = new Date(animal.createdAt).toLocaleDateString('es-ES', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<MainLayout title={`${animal.nombre} | Detalles`}>
  <div class="page-container">
    
    <nav class="breadcrumb">
      <a href="/">← Volver al Catálogo</a>
    </nav>

    <article class="animal-card-full">
      
      <div class="image-wrapper">
        {animal.imagenUrl ? (
          <img src={animal.imagenUrl} alt={animal.nombre} class="main-image" />
        ) : (
          <div class="no-image">🌿 Sin imagen disponible</div>
        )}
        <div class={`status-badge ${animal.riesgo.toLowerCase().replace(/\s+/g, '-')}`}>
          {animal.riesgo}
        </div>
      </div>

      <div class="info-wrapper">
        <header>
          <span class="category-tag">Especie Registrada</span>
          <h1>{animal.nombre}</h1>
          <p class="habitat-subtitle">🌍 Ubicación: <strong>{animal.habitat}</strong></p>
        </header>

        <div class="content-body">
          <div class="stats-grid">
            <div class="stat-box">
              <span class="stat-label">Estado de Riesgo</span>
              <span class="stat-value">{animal.riesgo}</span>
            </div>
            <div class="stat-box">
              <span class="stat-label">Fecha de Avistamiento</span>
              <span class="stat-value">{fechaRegistro}</span>
            </div>
          </div>

          <div class="description-text">
            <h3>Sobre este ejemplar</h3>
            <p>
              Este ejemplar de <strong>{animal.nombre}</strong> ha sido documentado como parte de nuestro esfuerzo por catalogar la biodiversidad local. 
              Actualmente se encuentra en un estado de conservación <strong>{animal.riesgo}</strong> en la zona de {animal.habitat}.
            </p>
            <p class="note">
              * La información mostrada ha sido verificada por la comunidad de NatureApp.
            </p>
          </div>
        </div>

        <footer class="card-footer">
          <button onclick="window.print()" class="btn-action">Imprimir Ficha</button>
          <button onclick="alert('Funcionalidad de compartir próximamente')" class="btn-secondary">Compartir</button>
          {userName ? (
            <button
              onclick="toggleFavoritoAnimal(this)"
              data-animal-id={animal.id}
              class="btn-favorite"
            >
              {isFavorito ? '💔 Quitar de Favoritos' : '❤️ Añadir a Favoritos'}
            </button>
          ) : (
            <a href="/login" class="btn-favorite-login">🔑 Inicia sesión para favoritos</a>
          )}
        </footer>
      </div>

    </article>

    <!-- Sección de Galería -->
    <section class="gallery-section">
      <h2>🖼️ Galería de Imágenes</h2>
      
      <!-- Formulario para agregar imagen -->
      {userName ? (
        <div class="upload-form">
          <div class="form-group">
            <label for="imagen-url">Agregar nueva imagen:</label>
            <input 
              type="text" 
              id="imagen-url" 
              placeholder="Pega la URL de una imagen (ej: https://...)"
              class="url-input"
            />
          </div>
          <button onclick="agregarImagen(this)" data-animal-id={animal.id} class="btn-submit">+ Subir Imagen</button>
          <div id="upload-message" class="message"></div>
        </div>
      ) : (
        <p class="login-prompt">
          <a href="/login">Inicia sesión</a> para contribuir imágenes a la galería.
        </p>
      )}

      <!-- Galería de imágenes -->
      <div class="gallery-grid">
        {animal.imagenUrl && (
          <div class="gallery-item">
            <img src={animal.imagenUrl} alt={animal.nombre} class="gallery-image" />
            <span class="gallery-badge">Principal</span>
          </div>
        )}
        
        {imagenes && imagenes.length > 0 ? (
          imagenes.map((imagen) => (
            <div class="gallery-item">
              <img src={imagen.url} alt="Imagen de {animal.nombre}" class="gallery-image" />
              <div class="gallery-overlay">
                <button onclick="eliminarImagen(this)" data-imagen-id={imagen.id} class="btn-delete">🗑️ Eliminar</button>
              </div>
            </div>
          ))
        ) : (
          animal.imagenUrl == null && (
            <p class="no-images">Aún no hay imágenes. ¡Sé el primero en contribuir! 📸</p>
          )
        )}
      </div>
    </section>

    <!-- Sección de Comentarios -->
    <section class="comments-section">
      <h2>💬 Comentarios de la Comunidad</h2>
      
      <!-- Formulario para agregar comentario -->
      {userName ? (
        <div class="comment-form">
          <textarea 
            id="comentario-input" 
            placeholder="Comparte tu observación sobre este animal..." 
            rows="4"
          ></textarea>
          <button onclick="enviarComentario(this)" data-animal-id={animal.id} class="btn-submit">Publicar Comentario (+5 pts)</button>
          <div id="comment-message" class="message"></div>
        </div>
      ) : (
        <p class="login-prompt">
          <a href="/login">Inicia sesión</a> para comentar y gana puntos por participar.
        </p>
      )}

      <!-- Lista de Comentarios -->
      <div class="comments-list">
        {comentarios && comentarios.length > 0 ? (
          comentarios.map((comentario) => (
            <div class="comment-card">
              <div class="comment-header">
                <strong class="comment-author">{comentario.usuario.nombre}</strong>
                <span class="comment-date">
                  {new Date(comentario.createdAt).toLocaleDateString('es-ES', {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric'
                  })}
                </span>
              </div>
              <p class="comment-content">{comentario.contenido}</p>
            </div>
          ))
        ) : (
          <p class="no-comments">Sé el primero en comentar sobre este animal 🌟</p>
        )}
      </div>
    </section>
  </div>
</MainLayout>

<style>
  /* Contenedor principal */
  .page-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem;
  }

  .breadcrumb a {
    text-decoration: none;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: opacity 0.2s;
  }
  .breadcrumb a:hover { opacity: 0.7; }

  /* La Gran Ficha */
  .animal-card-full {
    display: grid;
    grid-template-columns: 1.2fr 1fr; /* Proporción imagen/texto */
    background: white;
    margin-top: 1.5rem;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    min-height: 600px;
  }

  /* Responsive: una columna en móviles */
  @media (max-width: 850px) {
    .animal-card-full {
      grid-template-columns: 1fr;
    }
  }

  /* Estilos de Imagen */
  .image-wrapper {
    position: relative;
    background: #222;
  }

  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .no-image {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    background: #f4f4f4;
  }

  /* Etiquetas de Estado */
  .status-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 0.6rem 1.2rem;
    border-radius: 12px;
    color: white;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    background: #666; /* Color base */
  }

  /* Variantes de color según el riesgo */
  .critico { background: #e63946; }
  .en-peligro { background: #f4a261; }
  .vulnerable { background: #e9c46a; }
  .seguro { background: #2a9d8f; }

  /* Estilos de Información */
  .info-wrapper {
    padding: 3rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .category-tag {
    color: var(--primary);
    font-weight: 800;
    font-size: 0.75rem;
    text-transform: uppercase;
