---
import MainLayout from "../layouts/MainLayout.astro";
import { prisma } from "../lib/db";

// Obtener parámetros de búsqueda
const id1 = Astro.url.searchParams.get("id1") ? parseInt(Astro.url.searchParams.get("id1") || "0") : null;
const id2 = Astro.url.searchParams.get("id2") ? parseInt(Astro.url.searchParams.get("id2") || "0") : null;
const tipo = Astro.url.searchParams.get("tipo") || "animal"; // "animal" o "planta"

let especie1 = null;
let especie2 = null;

if (id1 && id2) {
  if (tipo === "animal") {
    especie1 = await prisma.animal.findUnique({ where: { id: id1 } });
    especie2 = await prisma.animal.findUnique({ where: { id: id2 } });
  } else {
    especie1 = await prisma.planta.findUnique({ where: { id: id1 } });
    especie2 = await prisma.planta.findUnique({ where: { id: id2 } });
  }
}

// Obtener listas de especies para los selects
const animales = await prisma.animal.findMany({ select: { id: true, nombre: true } });
const plantas = await prisma.planta.findMany({ select: { id: true, nombre: true } });
---

<MainLayout title="Comparador de Especies">
  <div class="comparador-container">
    <h1>🔍 Comparador de Especies</h1>
    
    <form action="/comparar" method="GET" class="comparador-form">
      <div class="form-row">
        <div class="form-group">
          <label>Tipo</label>
          <select name="tipo" onchange="this.form.submit()">
            <option value="animal" selected={tipo === "animal"}>🦁 Animales</option>
            <option value="planta" selected={tipo === "planta"}>🌸 Plantas</option>
          </select>
        </div>

        <div class="form-group">
          <label>Primera Especie</label>
          <select name="id1" required>
            <option value="">Selecciona una especie</option>
            {tipo === "animal" 
              ? animales.map(a => (
                  <option value={a.id} selected={id1 === a.id}>{a.nombre}</option>
                ))
              : plantas.map(p => (
                  <option value={p.id} selected={id1 === p.id}>{p.nombre}</option>
                ))
            }
          </select>
        </div>

        <div class="form-group">
          <label>Segunda Especie</label>
          <select name="id2" required>
            <option value="">Selecciona una especie</option>
            {tipo === "animal" 
              ? animales.map(a => (
                  <option value={a.id} selected={id2 === a.id}>{a.nombre}</option>
                ))
              : plantas.map(p => (
                  <option value={p.id} selected={id2 === p.id}>{p.nombre}</option>
                ))
            }
          </select>
        </div>

        <button type="submit" class="btn-comparar">Comparar</button>
      </div>
    </form>

    {especie1 && especie2 ? (
      <div class="comparacion">
        <div class="especie-card">
          <div class="especie-imagen">
            {especie1.imagenUrl ? (
              <img src={especie1.imagenUrl} alt={especie1.nombre} />
            ) : (
              <div class="no-img">{tipo === "animal" ? "🦁" : "🌸"}</div>
            )}
          </div>
          <h2>{especie1.nombre}</h2>
          <div class="comparacion-detalles">
            <div class="detalle">
              <span class="label">Especie:</span>
              <span class="valor">{especie1.especie || "No especificado"}</span>
            </div>
            <div class="detalle">
              <span class="label">Hábitat:</span>
              <span class="valor">{especie1.habitat}</span>
            </div>
            <div class="detalle">
              <span class="label">Riesgo:</span>
              <span class="valor riesgo" class:list={[especie1.riesgo.toLowerCase()]}>
                {especie1.riesgo}
              </span>
            </div>
            <div class="detalle full-width">
              <span class="label">Descripción:</span>
              <span class="valor">{especie1.descripcion || "Sin descripción"}</span>
            </div>
          </div>
        </div>

        <div class="vs-divider">VS</div>

        <div class="especie-card">
          <div class="especie-imagen">
            {especie2.imagenUrl ? (
              <img src={especie2.imagenUrl} alt={especie2.nombre} />
            ) : (
              <div class="no-img">{tipo === "animal" ? "🦁" : "🌸"}</div>
            )}
          </div>
          <h2>{especie2.nombre}</h2>
          <div class="comparacion-detalles">
            <div class="detalle">
              <span class="label">Especie:</span>
              <span class="valor">{especie2.especie || "No especificado"}</span>
            </div>
            <div class="detalle">
              <span class="label">Hábitat:</span>
              <span class="valor">{especie2.habitat}</span>
            </div>
            <div class="detalle">
              <span class="label">Riesgo:</span>
              <span class="valor riesgo" class:list={[especie2.riesgo.toLowerCase()]}>
                {especie2.riesgo}
              </span>
            </div>
            <div class="detalle full-width">
              <span class="label">Descripción:</span>
              <span class="valor">{especie2.descripcion || "Sin descripción"}</span>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="no-selection">
        <p>Selecciona dos especies para compararlas</p>
      </div>
    )}
  </div>
</MainLayout>

<style>
  .comparador-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  h1 {
    text-align: center;
    color: var(--primary);
    margin-bottom: 2rem;
  }

  .comparador-form {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    margin-bottom: 3rem;
  }

  .form-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: flex-end;
  }

  .form-group {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-weight: bold;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .form-group select {
    padding: 0.8rem;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
  }

  .btn-comparar {
    background: var(--primary);
    color: white;
    padding: 0.8rem 2rem;
    border: none;
    border-radius: 8px;
    font-weight: bold;
    cursor: pointer;
    transition: transform 0.2s;
  }

  .btn-comparar:hover {
    transform: scale(1.05);
  }

  .comparacion {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3rem;
  }

  .especie-card {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    padding: 2rem;
  }

  .especie-imagen {
    width: 100%;
    height: 250px;
    background: #f0f0f0;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }

  .especie-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-img {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
  }

  .especie-card h2 {
    margin: 0 0 1.5rem 0;
    color: var(--primary);
    font-size: 1.6rem;
    text-align: center;
  }

  .comparacion-detalles {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .detalle {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .detalle.full-width {
    grid-column: 1 / -1;
  }

  .label {
    font-weight: bold;
    color: var(--primary);
    font-size: 0.9rem;
  }

  .valor {
    color: #666;
    padding: 0.5rem;
    background: #f9f9f9;
    border-radius: 5px;
    border-left: 3px solid var(--primary);
  }

  .riesgo {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-weight: bold;
    display: inline-block;
    text-align: center;
  }

  .riesgo.seguro {
    background: #d4edda;
    color: #155724;
  }

  .riesgo.vulnerable {
    background: #fff3cd;
    color: #856404;
  }

  .riesgo.en\ peligro {
    background: #f8d7da;
    color: #721c24;
  }

  .riesgo.crítico {
    background: #e74c3c;
    color: white;
  }

  .vs-divider {
    font-size: 2rem;
    font-weight: bold;
    color: var(--primary);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .no-selection {
    text-align: center;
    padding: 3rem;
    background: white;
    border-radius: 15px;
    color: #999;
  }

  @media (max-width: 968px) {
    .comparacion {
      grid-template-columns: 1fr;
    }

    .vs-divider {
      transform: rotate(90deg);
      margin: -1rem 0;
    }

    .form-row {
      flex-direction: column;
    }

    .form-group {
      width: 100%;
    }
  }
</style>
